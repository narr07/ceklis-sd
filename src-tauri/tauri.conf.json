{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ceklis SD",
  "version": "1.4.0",
  "identifier": "com.narr07.ceklissd",
  "build": {
    "beforeDevCommand": "bun run dev:desktop",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bun run generate:desktop",
    "frontendDist": "../.output/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ceklis SD - Administrasi Sekolah Dasar",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "visible": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost https: http://localhost:* http://127.0.0.1:*",
        "img-src": "'self' data: blob:",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Dinar Permadi Yusup",
    "copyright": "© 2026 Dinar Permadi Yusup. MIT License.",
    "category": "Productivity",
    "shortDescription": "Checklist & template administrasi Sekolah Dasar offline.",
    "longDescription": "Checklist awal semester, tahun ajaran, dan tahun anggaran serta generator dokumen Word (.docx) untuk operator, kepala sekolah, dan bendahara SD.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Indonesian", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
